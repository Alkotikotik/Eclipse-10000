func main(){
    >_ Benchmark for branch predictor print 0-9
    >_ No branch predictor(20.7MHz): 7.52, 7.70 7.33. avg: 7.52
    >_ Resolve uncond in IF: 6.63, 6.80, 6.76. avg:  6.73 - nice
    u8 counter0;
    u32 counter1;
    u8 char[1];
    u8 prev_char;
    u16 color = 1;
    u16 x = 8;
    while [true] {
        counter1 = counter1 + 1;
        char[0] = counter0;
        if [counter1 > 200000]{
            color = color * 0xF;
            counter1 = 0;
            kprintr(x, 8, color, 0x0000, &char, 1);
            if [counter0 == prev_char]{
                counter0 = 0;
                prev_char = prev_char + 1;
                x = x + 10;
            } else {
                counter0 = counter0 + 1;
            }
        }
    }
}

>_ Kernel print raw
func kprintr(u16 cell_x, u16 cell_y, u16 fg, u16 bg, *u8 string, u8 len){

    for [u32 char; char < len; char = char + 1] {
        u32 char_idx = [string + char];
        [4000 + char * 4] = [string + char];

        if [char_idx == 0xFF]{ >_0xFF is no character
            return;
        }

        u32 offset = char_idx << 4;

        >_ Draw each char pixel by pixel
        for [u32 row; row < 16; row = row + 1] {
            u8 bits = font_data[offset + row];
            u8 mask = 0x80;
            u32 row_addr = VRAM_BASE + (((cell_y + row) * SCREEN_WIDTH + cell_x) << 1);

            for [u32 col; col < 8; col = col + 1] {
                u32 addr = row_addr + (col << 1);

                if [(bits & mask) == mask] {
                    [addr] = fg;
                } else {
                    [addr] = bg;
                }
                mask = mask >> 1;
            }
        }
        cell_x = cell_x + 10;
    }
}
