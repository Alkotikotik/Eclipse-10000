inline[
    #ORG 60
    ~JmpBoot:
        JMP ~boot

    #ORG 100   >_ 0x64 Syscall Vector
        RETU

    #ORG 104   >_ 0x68 Timer Vector
        RETU

    #ORG 108   >_ 0x6C Key Interrupt Vector
        JMP ~HandleKey
        >_RETU

    #ORG 112   >_ 0x70 Memory Fault Vector
        RETU
    ~boot:
outline];

regarch RGBA {
   u8 r;
   u8 g;
   u8 b;
   u8 a;
};

func main() {
    u32 ptr = 0x04000000;

    #rx29 RGBA colors;

    colors.r = 15;
    colors.g = 0;
    colors.b = 0;
    colors.a = 15;

    u8 phase = 0;

    while [true] {
        u32 color = (colors.r << 12) | (colors.g << 8) | (colors.b << 4) | colors.a;
        [ptr] = color;
        ptr = ptr + 2;

        if [phase == 0] {
            colors.r = colors.r - 1;
            colors.g = colors.g + 1;
            if [colors.g == 15] {
                phase = 1;
            }
        }
        else if [phase == 1] {
            colors.g = colors.g - 1;
            colors.b = colors.b + 1;
            if [colors.b == 15] {
                phase = 2;
            }
        }
        else if [phase == 2] {
            colors.b = colors.b - 1;
            colors.r = colors.r + 1;
            if [colors.r == 15] {
                phase = 0;
            }
        }
    }
}
