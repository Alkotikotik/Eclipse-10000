func main() {
    u32 ptr = 0x04000000;

    u32 r = 15;
    u32 g = 0;
    u32 b = 0;
    u32 a = 15;

    u8 phase = 0;

    while [true] {
        u32 color = (r << 12) | (g << 8) | (b << 4) | a;
        [ptr] = color;
        ptr = ptr + 2;

        if [phase == 0] {
            r = r - 1;
            g = g + 1;
            if [g == 15] {
                phase = 1;
            }
        }
        else if [phase == 1] {
            g = g - 1;
            b = b + 1;
            if [b == 15] {
                phase = 2;
            }
        }
        else if [phase == 2] {
            b = b - 1;
            r = r + 1;
            if [r == 15] {
                phase = 0;
            }
        }
    }
}

