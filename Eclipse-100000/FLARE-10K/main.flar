>_ FLARE-10K Language example
#def u32 X_BOUND = 360;
#def u32 Y_BOUND = 240;

>_ regular struct
arch PageTableEntry{
    u32 Entry;
    u8 flags;
};

>_ Struct that is stored in register, total size must be 4 bytes
regarch Rgba {
    u8 r;
    u8 g;
    u8 b;
    u8 a;
};

>_ Global structs are avaliable, they can kinda be used as OOP
#def #rx11 Rgba color;

func bootstrap_os(u32 x, u32 y, *PageTableEntry z) => u32 c{ >_ c acts as a regular var in that func


    >_ bitwises
    u32 w = 256;
    u32 r = 2;
    w = w << r;
    w = w >> r;
    w = w & r;
    w = w | r;
    w = w ^ r;

    >_ w = w % w; mod and division aren't implemented yet

    [z].Entry = 18;

    PageTableEntry sigma;
    sigma.Entry = 20;
    sigma.flags = 1;

    u32 arr[4];

    [0xFFFFFF08] = 4096; >_ standalone value in square brackets always means contents of the address specified
    [0xFFFFFF0C] = 16384;

    u32 value = [0xFFFFFF08]; >_ so value = 4096
    u32 value1 = 0xFFFFFF08;
    [value1] = 512; >_ now value = 512


    #rx0 i32 a = 256; >_ a is stored in rx0 no matter what
    color = get_color(); >_ Same as Rgba
    i16 b;
    b = a * -256;

    for [u32 i = 0; i < 5; i = i + 1] {
        arr[i] = i;
        c = arr[i];
    }
    while [true] {
        >_ It works just fine(ignoring subtle fact that it will just be stuck forever)
        if [false]{
            break;
        }
    }

    if [c == 128] {
        for [u32 j = 2; j < 64; j = j + 2] {
            c = c - 2;
        }
    }

    c = x * y; >_ Overflow you are cooked buddy

    inline [
        XOR [rx0, rx0]
        LOAD rx12 <- 0x10
    outline];

    >_return c; last value of c is automatically returned, tho it can be returned explicetely
}

func main(){

    PageTableEntry z;
    z.Entry = 10;
    z.flags = 11;

    bootstrap_os(X_BOUND, Y_BOUND, &z);
}

func get_color() => Rgba color {
    color.r = 255;
    color.g = 255;
    color.b = 0;
    color.a = 1;
}
