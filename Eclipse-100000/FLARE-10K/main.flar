>_ FLARE-10K Language example
#def u32 X_BOUND = 360;
#def u32 Y_BOUND = 240;

>_ regular struct
arch PageTableEntry{
    u32 Entry;
    u8 flags;
};

>_ Struct that is stored in register, total size must be 4 bytes
regarch Rgba {
    u8 r;
    u8 g;
    u8 b;
    u8 a;
};

>_ Global structs are avaliable, they can kinda be used as OOP
#def #rx11 Rgba color;

func main(){

    PageTableEntry z;
    z.Entry = 10;
    z.flags = 11;
    [4008] = 15;
    u32 c = bootstrap_os(4, 8, &z);
    [4000] = c;
}

func bootstrap_os(u32 x, u32 y, *PageTableEntry z) => #rx29 u32 c { >_ c acts as a regular var in that func

    [4012] = x;
    [4016] = y;

    >_ bitwises
    u16 w = 256;
    u8 r = 2;
    w = w << 3;
    w = w >> 2;
    w = w & r;
    w = w | r;
    w = w ^ r;

    c = c + (w as u32);

    >_ w = w % w; mod and division aren't implemented yet

    [z].Entry = 18;

    PageTableEntry sigma;
    sigma.Entry = 20;
    sigma.flags = 1;

    c = c + [z].Entry;

    u32 arr[4];

    [0xFFFFFF08] = 4096; >_ standalone value in square brackets always means contents of the address specified
    [0xFFFFFF0C] = 16384;

    u32 value = [0xFFFFFF08]; >_ so value = 4096
    u32 value1 = 0xFFFFFF08;
    [value1] = 512; >_ now value = 512

    c = c + [value1];


    [4012] = x;
    [4016] = y;

    color = get_color(); >_ Same as Rgba

    [4020] = x;
    [4024] = y;

    for [u32 i; i < x; i = i + 1] {
        arr[i] = i;
        c = c + arr[i];
    }
    bool isTrue = true;
    bool isFalse = false;
    while [isTrue] {
        >_ It works just fine(ignoring subtle fact that it will just be stuck forever)
        if [isFalse]{
            c = c + color.r;
            break;
        } else { >_ not anymore
            c = c + color.g;
            break;
        }
        break; >_ jic
    }

    if [c == c] {
        for [u32 j = 2; j < y; j = j + 2] {
            c = c - 2;
        }
    }

    inline [
        ADD rx29 <- [rx29, rx31 + 2]
        XOR [rx31, rx31]
    outline];

    c = c + X_BOUND;
    c = c - Y_BOUND;

    >_return c; last value of c is automatically returned, tho it can be returned explicetely
}

func get_color() => Rgba color {
    color.r = 255;
    color.g = 255;
    color.b = 0;
    color.a = 1;
}
