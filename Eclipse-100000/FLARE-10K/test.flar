regarch coords {
    i16 x;
    i16 y;
};

#def #rx29 coords cube;

func main() {
    u32 ptr = 4096;
    init_cube();

    while [true] {
        if [ptr < 4000] {
            break;
        }

        [ptr] = cube.x * 4;
        [ptr - 4] = cube.y * 4;
        ptr = ptr - 8;

    }
}

func init_cube(){
    cube.x = 1;
    cube.y = 2;
}
