regarch coords {
    i16 x;
    i16 y;
};

#def #rx29 coords cube;

func main() {
    u32 ptr = 4096;
    init_cube();

    while [1 == 1] {
        [ptr] = cube.x * 4;
        [ptr - 4] = cube.y * 4;
        ptr = ptr - 8;
        if [ptr < 2048] {
            break;
        }
    }
}

func init_cube(){
    cube.x = 1;
    cube.y = 2;
}
