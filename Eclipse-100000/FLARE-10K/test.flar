func main() {
    u32 a = 0;
    u32 b = 1;
    u32 c = 4100;

    u32 result;
    for [u8 i = 0; i < 19; i = i + 1] {
        result = a + b;
        a = b;
        b = result;
        c = c - 4;
        [c] = result;
    }
    u32 res = double(2);
    [4016] = res;
}

func double(u8 num) => u8 result{
  result = num * 2;
}
