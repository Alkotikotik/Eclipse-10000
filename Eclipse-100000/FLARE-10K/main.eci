~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	LOAD ry30 <- 0
	LOAD ry31 <- 1024
	LOAD ry10 <- 0

~Lab_while_start_0:
	LOAD rx30 <- 1
	LOAD rx30 <- 0
	CMP rx30 <-> rx30
	XOR [rx30, rx30 0]
	BNE -> ~Lab_while_end_1
	STR ry10 -> [rx3 0]
	MOV rx2 <- ry10 0
	NOT rx2
	SUB rx0 <- [rx3, rx31 2]
	STR rx2 -> [rx0 0]
	ADD rx0 <- [rx3, rx31 2]
	MOV rx3 <- rx0 0
	ADD rx0 <- [ry10, rx31 2]
	MOV ry10 <- rx0 0
	LOAD rx30 <- 65535
	CMP ry10 <-> rx30
	XOR [rx30, rx30 0]
	BSU -> ~Lab_endif_3
	LOAD ry10 <- 0

~Lab_endif_3:
	JMP -> ~Lab_while_start_0

~Lab_while_end_1:
	RET
