~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	SPRLEA rx30 <- [LR 0]
	PUSH <- rx30
	LOAD rx1 <- 4096
	PUSH <- rx1
	CALL init_cube
	POP -> rx1

~Lab_while_start_0:
	LOAD rx30 <- 1
	LOAD rx30 <- 1
	CMP rx30 <-> rx30
	XOR [rx30, rx30 0]
	BEQ -> ~Lab_while_start_0
	MOV rx0 <- ry290 0
	LOAD rx30 <- 4
	MUL rx0 <- [rx0, rx30 0]
	STR rx0 -> [rx1 0]
	MOV rx0 <- ry291 0
	LOAD rx30 <- 4
	MUL rx2 <- [rx0, rx30 0]
	LOAD rx30 <- 4
	SUB rx0 <- [rx1, rx30 0]
	STR rx2 -> [rx0 0]
	LOAD rx30 <- 8
	SUB rx0 <- [rx0, rx30 0]
	MOV rx1 <- rx0 0
	LOAD rx30 <- 4000
	CMP rx1 <-> rx30
	XOR [rx30, rx30 0]
	BSU -> ~Lab_endif_3
	JMP -> ~Lab_while_start_0

~Lab_endif_3:
	JMP -> ~Lab_while_end_1

~Lab_while_end_1:
	POP -> rx31
	SPRSET rx31 -> LR
	JMP ~End

~init_cube:
	LOAD ry290 <- 1
	LOAD ry291 <- 2
	RET
~End:
