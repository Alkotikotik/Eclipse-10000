~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	SPRSUB rx31 ->SP<- 16
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 0]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 4]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 8]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 12]
	XOR [rx30, rx30 0]
	LOAD rx27 <- 0

	IBGU <-< [rx27 <-> 512] >-> ~Lab_for_end_1


~Lab_for_start_0:
	LOAD rx30 <- 64
	DIV rx28 <- [rx27, rx30 0]
	SPRLEA rx29 <- [SP 0]
	STX rx28 >-> [rx29, rx27 << 2 + 0]
	SPRLEA rx29 <- [SP 0]
	LDX rx28 <-< [rx29, rx27 << 2 + 0]
	STX rx28 >-> [rx31, rx27 << 2 + 4000]
	LOAD rx30 <- 128
	ADD rx27 <- [rx27, rx30 0]

	IBSEU <-< [rx27 <-> 512] >-> ~Lab_for_start_0


~Lab_for_end_1:
	SPRADD rx31 ->SP<- 16
	RET
