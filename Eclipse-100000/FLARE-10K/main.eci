~init_0x00:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	SPRSUB rx31 ->SP<- 256
	SPRLEA rx27 <- [SP 0]
	LOAD rx25 <- 0

	IBGEU [rx25 <-> 8] >-> ~Lab_for_end_1


~Lab_for_start_0:
	LOAD rx26 <- 0

	IBGEU [rx26 <-> 8] >-> ~Lab_for_end_3


~Lab_for_start_2:
	ADD  rx29 <- [rx25, rx26 0]
	MDSX rx29 >=> [rx27, [rx25 * 32] + [rx26 << 2] + 0]
	MDLX rx28 <=< [rx27, [rx25 * 32] + [rx26 << 2] + 0]
	STX  rx28 >=> [rx31, rx29 << 2 + 4000]
	ADD  rx26 <- [rx26, rx31 1]

	IBSU [rx26 <-> 8] >-> ~Lab_for_start_2


~Lab_for_end_3:
	ADD  rx25 <- [rx25, rx31 1]

	IBSU [rx25 <-> 8] >-> ~Lab_for_start_0


~Lab_for_end_1:
	SPRADD rx31 ->SP<- 256
	RET
