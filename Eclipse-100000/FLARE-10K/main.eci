#ORG 0x1000
LMA rx31 <- ~this_is_the_end_0x00
SPRSET rx31 -> SP
~init_0x00:
	XOR [rx31, rx31]

~main:
	LOAD rx29 <- 0
	MOV  rx0 <- rx29 0
	CALL rec

	MOV  rx29 <- rx30 0
	STX  rx29 >=> [rx31, rx31 << 0 + 4000]
	RET

~rec:
	MOV  rx29 <- rx0 0
	ADD  rx29 <- [rx29, rx31 1]

	IBNE [rx29 <-> 100000] >-> ~Lab_endif_1

	MOV  rx30 <- rx29 0
	RET

~Lab_endif_1:
	MOV  rx0 <- rx29 0
	CALL rec

	MOV  rx29 <- rx30 0
	MOV  rx30 <- rx29 0
	RET
~this_is_the_end_0x00:
