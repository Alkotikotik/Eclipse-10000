#ORG 60
~JmpBoot:
	JMP ~boot
	
#ORG 100   >_ 0x64 Syscall Vector
	RETU
	
#ORG 104   >_ 0x68 Timer Vector
	RETU
	
#ORG 108   >_ 0x6C Key Interrupt Vector
	JMP ~HandleKey
	>_RETU
	
#ORG 112   >_ 0x70 Memory Fault Vector
	RETU
~boot:
~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	LMA rx27 <- 67108864
	LOAD ry281 <- 0
	LOAD ry280 <- 0
	LOAD rz260 <- 0

~Lab_while_start_0:
	MOV rx29 <- ry281 0
	SHL [rx29, rx31 16]
	OR  [rx29, ry280 0]
	STR rx29 -> [rx27 0]
	LOAD rx30 <- 4
	ADD rx27 <- [rx27, rx30 0]

	IBNE <-< [rz260 <-> 0] >-> ~Lab_else_2

	ADD ry281 <- [ry281, rx31 1]
	LOAD rx30 <- 1
	MOV rx29 <- rx30 0
	SHL [rx29, rx31 8]
	SUB ry280 <- [ry280, rx29 0]

	IBNE <-< [ry281 <-> 15] >-> ~Lab_endif_5

	LOAD rz260 <- 1

~Lab_endif_5:
	JMP -> ~Lab_endif_3


~Lab_else_2:

	IBNE <-< [rz260 <-> 1] >-> ~Lab_else_6

	SUB ry281 <- [ry281, rx31 1]
	LOAD rx30 <- 1
	MOV rx29 <- rx30 0
	SHL [rx29, rx31 8]
	ADD ry280 <- [ry280, rx29 0]

	IBSU <-< [ry280 <-> 239] >-> ~Lab_endif_9

	LOAD rz260 <- 2

~Lab_endif_9:
	JMP -> ~Lab_endif_7


~Lab_else_6:

	IBNE <-< [rz260 <-> 2] >-> ~Lab_endif_11

	LOAD rx30 <- 1
	MOV rx29 <- rx30 0
	SHL [rx29, rx31 8]
	SUB ry280 <- [ry280, rx29 0]
	LOAD rx30 <- 1
	MOV rx29 <- rx30 0
	SHL [rx29, rx31 8]
	ADD ry281 <- [ry281, rx29 0]

	IBSU <-< [ry281 <-> 239] >-> ~Lab_endif_13

	LOAD rz260 <- 0

~Lab_endif_13:

~Lab_endif_11:

~Lab_endif_7:

~Lab_endif_3:
	JMP -> ~Lab_while_start_0


~Lab_while_end_1:
	RET
