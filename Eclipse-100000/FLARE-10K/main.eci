~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	SPRLEA rx30 <- [LR 0]
	PUSH <- rx30
	LOAD rx2 <- 4096
	PUSH <- rx2
	CALL init_cube
	POP -> rx2

~Lab_while_start_0:
	LOAD rx30 <- 1
	LOAD rx30 <- 0
	CMP rx30 <-> rx30
	XOR [rx30, rx30 0]
	BNE -> ~Lab_while_end_1
	LOAD rx30 <- 4000
	CMP rx2 <-> rx30
	XOR [rx30, rx30 0]
	BGU -> ~Lab_endif_3
	JMP -> ~Lab_while_end_1

~Lab_endif_3:
	MOV rx0 <- ry290 0
	LOAD rx30 <- 4
	MUL rx0 <- [rx0, rx30 0]
	STR rx0 -> [rx2 0]
	MOV rx0 <- ry291 0
	LOAD rx30 <- 4
	MUL rx1 <- [rx0, rx30 0]
	LOAD rx30 <- 4
	SUB rx0 <- [rx2, rx30 0]
	STR rx1 -> [rx0 0]
	LOAD rx30 <- 8
	SUB rx0 <- [rx2, rx30 0]
	MOV rx2 <- rx0 0
	JMP -> ~Lab_while_start_0

~Lab_while_end_1:
	POP -> rx31
	SPRSET rx31 -> LR
	RET

~init_cube:
	LOAD ry290 <- 1
	LOAD ry291 <- 2
	RET
