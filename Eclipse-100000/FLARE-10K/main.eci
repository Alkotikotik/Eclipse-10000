~Lab_endif_13:

~Lab_endif_11:

~Lab_endif_7:

~Lab_endif_3:
	LOAD rx30 <- 4088
	LOAD rx31 <- 13
	STR rx31 -> [rx30 0]
	XOR [rx30, rx30 0]
	XOR [rx31, rx31 0]
