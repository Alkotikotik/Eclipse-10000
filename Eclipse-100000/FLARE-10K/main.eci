~Init_000:
	XOR [rx31, rx31]
	XOR [rx30, rx30]

~main:
	SPRSUB rx31 ->SP<- 16
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 0]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 4]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 8]
	XOR [rx30, rx30 0]
	LOAD rx30 <- 0
	SPRSTR rx30 -> [SP 12]
	XOR [rx30, rx30 0]
	LOAD rz280 <- 0

	IBGU <-< [rz280 <-> 4] >-> ~Lab_for_end_1


~Lab_for_start_0:
	SPRLEA rx29 <- [SP 0]
	STX rz280 >-> [rx29, rz280 << 2 + 0]
	ADD rz290 <- [rz280, rx31 1]
	MOV rz280 <- rz290 0

	IBSEU <-< [rz280 <-> 4] >-> ~Lab_for_start_0


~Lab_for_end_1:
	SPRADD rx31 ->SP<- 16
	RET
