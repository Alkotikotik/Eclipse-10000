~boot:
    JMP ~init

#ORG 4092
#[ init_dy 4 =>>= data ]#
    0x0102, 0x16FF,
    0x0102, 0x16F8,
#[ end ]#

#ORG 64
~init:
    >_#ALIA ry00 : test
    >_#ALIA 0x40000000 : VRAM_BASE
    LOAD rx2 <- 3 : three
    LDX  test <- rx31, three << 1, *data
    STX  test -> rx31, rx31 << 0, 4016

    JMP ~init
