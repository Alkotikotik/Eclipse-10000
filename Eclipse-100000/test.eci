~init:
    >_ 2D u8 2x2 array
    LOAD rx1 <- 4000
    LOAD rx20 <- 4004
    LMA rx0 <- 0x110B2040 >_ a = 64, b = 32, c = 11, d = 17
    STX rx0 -> rx31, rx1 << 0

~loop:
    MDLX rz20 <=< [rx1, rx31 * 0, rx3 << 0]
    MDSX rz20 >=> [rx20, rx31 * 0, rx3 << 0]

    ADD rx3 <- [rx3, rx31 + 1]
    IBSU rx3 <-> 3 -> ~loop
~finish:
    JMP ~finish


#[ init_db 256 =>>= font_data ]#

    0x64, 0x40, 0x20, 0x15,
    0x12, 0x52, 0xaa, 0xbb,
    0xaf, 0xab, 0xda, 0xcf,

#[ end ]#
