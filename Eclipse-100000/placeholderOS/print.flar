#def u32 VRAM_BASE = 0x04000000;
#def u32 SCREEN_WIDTH = 640;

>_ 16x8 font
#def u8 font_data[112] = {
    >_ Index 0 (real: 48)
    0x7E, 0xFF, 0xE7, 0xC3, 0xC3, 0xDB, 0xDB, 0xDB,
    0xDB, 0xDB, 0xDB, 0xC3, 0xC3, 0xE7, 0xFF, 0x7E,
    >_ Index 1 (real: 49)
    0x18, 0x38, 0x78, 0xF8, 0x18, 0x18, 0x18, 0x18,
    0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0xFF,
    >_ Index 2 (real: 50)
    0x7E, 0xFF, 0xE7, 0xC3, 0x03, 0x03, 0x03, 0x03,
    0x07, 0x0E, 0x1C, 0x38, 0x70, 0xE0, 0xFE, 0xFF,
    >_ Index 3 (real: 51)
    0x7E, 0xFF, 0x07, 0x03, 0x03, 0x03, 0x03, 0x7F,
    0xFE, 0x07, 0x03, 0x03, 0x03, 0x03, 0x7F, 0xFE,
    >_ Index 4 (real: 52)
    0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3,
    0xE7, 0xFF, 0x7F, 0x07, 0x03, 0x03, 0x03, 0x03,
    >_ Index 5 (real: 53)
    0x7E, 0xFF, 0xE0, 0xC0, 0xC0, 0xC0, 0xC0, 0xC0,
    0xFE, 0x7F, 0x07, 0x03, 0x03, 0x07, 0x7F, 0xFE,
    >_ Index 6 (real: 54)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

func main(){
    while [true] {
        draw_char(8, 8,  0xFFFF, 0x0000, 0);
        draw_char(8, 16, 0xFFFF, 0x0000, 1);
        draw_char(8, 24, 0xFFFF, 0x0000, 2);
        draw_char(8, 32, 0xFFFF, 0x0000, 3);
        draw_char(8, 40, 0xFFFF, 0x0000, 4);
    }
}

>_ Drawing char pixel my pixel
func draw_char(u16 cell_x, u16 cell_y, u16 fg, u16 bg, u8 char_idx) { >_ fg - color of char, bg - well bg
    [4004] = char_idx;

    u32 offset = char_idx << 4;

    for [u32 row; row < 16; row = row + 1] {
        u8 bits = font_data[offset + row];
        u8 mask = 0x80;
        >_ Calculing it now to save instructions
        u32 row_addr = VRAM_BASE + (((cell_y + row) * SCREEN_WIDTH + cell_x) << 1);

        for [u32 col; col < 8; col = col + 1] {
            >_ Finishing address calculation
            u32 addr = row_addr + (col << 1);

            if [(bits & mask) == mask] { >_ If pixel lands on pixel that needs to be draw - well draw it
                [addr] = fg;
            } else { >_ if not, draw bg instead
                [addr] = bg;
            }
            mask = mask >> 1;
        }
    }
}
