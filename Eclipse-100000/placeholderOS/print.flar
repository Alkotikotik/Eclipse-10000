func main(){
    >_u8 string[6] = {0, 1, 2, 3, 4, 5};
    u8 string[5] = {18, 19, 10, 11, 27};
    kpritf(8, 8, 0xFFFF, 0x0000, &string, 5);
    >_kpritf(8, 40, 0xF000, 0x0000, &string, 2);
    >_kpritf(8, 72, 0xC81F, 0x0000, &string, 4);
    while[true]{}
}

func kpritf(u16 cell_x, u16 cell_y, u16 fg, u16 bg, *u8 string, u8 len) {

    for [u32 char; char < len; char = char + 1] {
        u32 char_idx = [string + char];
        [4000 + char * 4] = [string + char];

        u32 offset = char_idx << 4;

        for [u32 row; row < 16; row = row + 1] {
            u8 bits = font_data[offset + row];
            u8 mask = 0x80;
            u32 row_addr = VRAM_BASE + (((cell_y + row) * SCREEN_WIDTH + cell_x) << 1);

            for [u32 col; col < 8; col = col + 1] {
                u32 addr = row_addr + (col << 1);

                if [(bits & mask) == mask] {
                    [addr] = fg;
                } else {
                    [addr] = bg;
                }
                mask = mask >> 1;
            }
        }
        cell_x = cell_x + 10;
    }
}
