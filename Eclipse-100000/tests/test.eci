>_ Just a collection of all my tests bc I don't wanna delete them...

~Init:
    LOAD rx30 <- 0
    LOAD rx1 <- 1
    LOAD rx2 <- -2042
    LMA 33000000
    MOV rx3 <- rx31
    XOR [rx31, rx31]
    >_SHL [rx3, rx30]
    LOAD rx30 <- 0

    LOAD rx4 <- 4088
    LOAD rz50 <- 2
    LOAD ry51 <- 2

    STR [rx2, rx4 - 172]
    LOAD rx10 <- 2043
    ADD [rx2, rx2, rx10]

    MOV ry61 <- rz50
    STR [ry61, rx4 - 152]
    MOV rz50 <- ry61
    STR [rz50, rx4 - 156]

    MOV rx6 <- ry51
    STR [rx6, rx4 - 160]
    MOV ry51 <- rx6
    STR [ry51, rx4 - 164]

    CALL ~A

~Loop:
    CMP rx30, rx3
    BGU ~End

    STR [rx30, rx4]

    SUB [rx4, rx4, rz50]
    SUB [rx4, rx4, ry51]

    ADD [rx2, rx30, rx1]
    MOV rx30 <- rx1
    MOV rx1 <- rx2

    JMP ~Loop

~A:
    LOAD rz23 <- 4
    XOR [rx3, rz23 + 1000] >_ Unsigned only
    ADD [rx3, rx3, rx31 - 1] >_ +1, +2 -1 only
    STR [rx3, rx4 + 4]
    XOR [rx3, rx23 + 1000]
    RET

~End:
    LOAD rx1 <- 4
    MOV [rx30, rx1]
    JR rx30

>_>
~boot:
    JMP ~init

#ORG 4088
#[ init_db 4 =>>= date ]#
    0x01, 0x02, 0x16, 0xFF,
#[ end ]#

#ORG 4000
#[ init_db 4 =>>= date0 ]#
    0x01, 0x02, 0x16, 0xFF,
#[ end ]#

~init:
    >_ 2D u8 2x2 array
    LOAD rx1 <- 4004
    LOAD rx20 <- 4008
    LMA rx0 <- 0x110B2040 >_ a = 64, b = 32, c = 11, d = 17
    STX rx0 -> rx31, rx1 << 0

~loop:
    MDLX rz20 <=< [rx1, rx31 * 0, rx3 << 0]
    MDSX rz20 >=> [rx20, rx31 * 0, rx3 << 0]

    ADD rx3 <- [rx3, rx31 + 1]
    IBSU rx3 <-> 3 -> ~loop
~finish:
    LMA rx0 <- ~date
    LOAD rx2 <- 1
    LDX rz10 <- rx0, rx31 << 0, 0
    STX rz10 -> rx31, rx31 << 0, 4016

    JMP ~finish
